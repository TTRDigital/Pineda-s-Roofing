{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "start.pinedasroofing.com" }], "destination": "/start/index.html" }
  ]
}
