# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Sanity (the site falls back to built-in copy until these are set)
# Project ID and dataset from sanity.io/manage (public, safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the /api/revalidate webhook (set the same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens). Not needed in Vercel.
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://www.pinedasroofing.com
# Placeholder blocks ([LIKE THIS]) are hidden by default. "true" shows them, for review on previews only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- GoHighLevel
# Inbound webhook (Automation > Workflows > trigger "Inbound Webhook"). Every
# form submission is POSTed here as flat JSON.
GHL_WEBHOOK_URL=
# Optional, in addition to the webhook: direct API delivery (contact upsert + tags + note)
GHL_LOCATION_ID=
GHL_API_KEY=
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty = no chat widget.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics (optional; nothing loads when empty)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
