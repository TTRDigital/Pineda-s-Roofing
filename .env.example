# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (project 5emjihiz is the default; the site shows built-in copy until the CMS has content)
# Project ID and dataset from sanity.io/manage (public, safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=5emjihiz
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://www.pinedasroofing.com
# Placeholder blocks ([LIKE THIS]) are hidden by default. "true" shows them, for review only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- GoHighLevel
# The estimate form's webhook is NOT set here: it lives in api/lead-config.php on
# SiteGround, written by the deploy workflow from the GHL_WEBHOOK_URL GitHub secret.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Defaults to Pineda's widget; "off" disables it.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=6ab171dc2251fa79522366eb

# --- Analytics (optional; nothing loads when empty)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
